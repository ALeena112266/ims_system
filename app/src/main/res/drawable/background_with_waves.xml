<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/background_pink" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/wave_purple"
                android:centerColor="@color/wave_pink"
                android:endColor="@color/background_pink"
                android:angle="270"
                android:type="linear" />
            <size android:height="250dp" />
        </shape>
    </item>
</layer-list>
